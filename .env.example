# ==============================================================================
# Django Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings (DO NOT CHANGE)
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ROOT_URLCONF=config.urls
DJANGO_WSGI_APPLICATION=config.wsgi.application
DJANGO_STATIC_URL=/static/
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key


# ------------------------------------------------------------------------------
# Django Development Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
# Production mode:
# - False: Uses SQLite (db.sqlite3) and enables django-browser-reload
# - True:  Uses PostgreSQL db
PRODUCTION=False


# ------------------------------------------------------------------------------
# Protected Operations
# ------------------------------------------------------------------------------
# Password required for form actions (add/edit/delete experiences and projects)
PASSWORD=change_this_admin_passcode

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings (Used when PRODUCTION=True)
# ------------------------------------------------------------------------------
DB_NAME=django
DB_USER=django
DB_PASSWORD=django
DB_HOST=localhost
DB_PORT=55432
SCHEMA=public